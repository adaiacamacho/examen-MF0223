<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechSpecs Manager</title>
    <link rel="stylesheet" href="css/estilos.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script type="module" src="js/examen.js"></script>
</head>

<body>
    <header>
        <h1>TechSpecs Manager</h1>
    </header>
    <section class="formulario">
        <form novalidate>
            <label for="nombre">Nombre del servidor: </label>
            <input type="text" name="nombre" id="nombre" required>
            <label for="cpu">CPU: </label>
            <input type="number" min="2" name="cpu" id="cpu" required>
            <label for="ram">RAM (GB): </label>
            <input type="number" min="4" name="ram" id="ram" required>
            <fieldset>
                <legend>Almacenamiento: </legend>
                <div class="btns">
                    <label for="ssd">SSD</label>
                    <input type="radio" name="alm" id="ssd" value="SSD" required>
                    <label for="hdd">HDD</label>
                    <input type="radio" name="alm" id="hdd" value="HDD">
                </div>
            </fieldset>
            <button class="btn btn-outline-dark">Enviar</button>
        </form>
    </section>
    <section>
        <div class="lista-cards">
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>